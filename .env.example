DATABASE_URL=              # fournie par l'intégration Neon
ADMIN_PASSWORD=            # mot de passe unique de connexion
SESSION_SECRET=            # 32+ caractères aléatoires
API_TOKEN=                 # token Bearer pour l'API (future extension)
PUBLIC_BASE_URL=           # ex: https://t.mondomaine.dev — base des URLs de pixel
APP_TIMEZONE=Africa/Casablanca
GRACE_PERIOD_SECONDS=180   # ouvertures ignorées après création du pixel
DEDUP_WINDOW_SECONDS=60    # fenêtre de dédoublonnage des ouvertures
